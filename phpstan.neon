includes:
    - vendor/larastan/larastan/extension.neon
    # Provides disallowedMethodCalls / disallowedStaticCalls, which is how T006 turns two
    # constitutional rules into build failures rather than review comments.
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
    # T006 — the highest level that passes on a bare skeleton. Raise it as the codebase grows;
    # lowering it later would be a silent weakening of a constitutional gate.
    level: 6

    paths:
        - app
        - config
        - database
        - routes
        - tests

    excludePaths:
        analyseAndScan:
            - design-system
            # Created by T464 when the design system migrates to v2; optional until then.
            - design-system-v1 (?)
            - bootstrap/cache
            - storage
            - public/build (?)

    # Constitution principle V: hard delete of any record with history is prohibited. Banning the
    # call makes that enforceable rather than reviewable, which is the whole point of having a
    # static-analysis gate.
    #
    # Constitution security floor: "Eloquent or parameterized queries only, never
    # string-concatenated SQL". The raw-query helpers are where that rule gets broken, so they are
    # banned too. A genuine need for one is a reviewed exception with a baseline entry and a reason,
    # not a quiet call site.
    disallowedMethodCalls:
        -
            method: 'Illuminate\Database\Eloquent\Model::forceDelete()'
            message: 'Hard delete is prohibited (constitution principle V). Use soft delete, deactivation, or withdrawal.'
        -
            method: 'Illuminate\Database\Eloquent\Builder::whereRaw()'
            message: 'Raw SQL is prohibited (constitution security floor). Use Eloquent or bindings.'
        -
            method: 'Illuminate\Database\Eloquent\Builder::selectRaw()'
            message: 'Raw SQL is prohibited (constitution security floor). Use Eloquent or bindings.'
        -
            method: 'Illuminate\Database\Query\Builder::whereRaw()'
            message: 'Raw SQL is prohibited (constitution security floor). Use Eloquent or bindings.'
        -
            method: 'Illuminate\Database\Query\Builder::selectRaw()'
            message: 'Raw SQL is prohibited (constitution security floor). Use Eloquent or bindings.'

    disallowedStaticCalls:
        -
            method: 'Illuminate\Support\Facades\DB::raw()'
            message: 'Raw SQL is prohibited (constitution security floor). Use Eloquent or bindings.'

    # Arabic strings are everywhere in this codebase. Treating them as anything but UTF-8 text would
    # produce noise, not findings.
    treatPhpDocTypesAsCertain: false

    # ── The one ignore in this configuration ─────────────────────────────────────────────────────
    #
    # Pest binds $this inside a test closure to the TestCase at runtime, and no static analyser can
    # see that: PHPStan resolves $this to Pest\PendingCalls\TestCall, which has none of the HTTP
    # testing methods. The result is one error per `$this->actingAs(...)` call site.
    #
    # Scoped as tightly as it can be: one identifier, one method, and only in the directories that
    # make HTTP requests. Everything else in tests/ is still analysed — a wrong argument type in a
    # fixture helper, a call to a method that genuinely does not exist, a bad return type all still
    # fail the build. Phase 2 avoided this by not using $this at all, which worked for unit-shaped
    # tests; `$this->actingAs()->get()` IS the testing API for a feature test, and rewriting 99 call
    # sites to dodge an analyser would make the tests worse.
    ignoreErrors:
        -
            identifier: method.notFound
            # Matched without the namespace, because a backslash-P in a PCRE pattern is the
            # unicode-property escape and the compile fails.
            message: '#Call to an undefined method .*TestCall::#'
            # Only the directories that currently make HTTP requests. Performance still holds
            # placeholders; when its first real test lands, add it here — an unmatched pattern fails
            # the build, which is what keeps this list honest. tests/Scope was added in US2, when
            # the scope suite started driving real requests.
            paths:
                - tests/Feature
                - tests/Authorization
                - tests/Scope
