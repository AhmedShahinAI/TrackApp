{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build:fonts": "node scripts/build-fonts.mjs",
        "build:icons": "node scripts/build-icons.mjs",
        "build:assets": "node scripts/copy-brand-assets.mjs",
        "prebuild": "npm run build:fonts && npm run build:icons && npm run build:assets",
        "build": "vite build",
        "test:js": "node --test tests/js/pow.test.mjs",
        "dev": "npm run prebuild && vite"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.0",
        "@fontsource/cairo": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@playwright/test": "^1.50.0",
        "axe-core": "^4.10.0",
        "laravel-vite-plugin": "^3.1",
        "lucide-static": "^0.460.0",
        "postcss": "^8.5.29",
        "rtlcss": "^4.3.0",
        "sass": "^1.83.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@alpinejs/csp": "^3.17.4",
        "alpinejs": "^3.14.0",
        "bootstrap": "^5.3.3"
    }
}
