APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=track
DB_USERNAME=root
DB_PASSWORD=
# utf8mb4 / utf8mb4_unicode_ci is set in config/database.php — the platform stores Arabic, and a
# latin1 database would pass tests and fail in production (constitution: Technology constraints).

SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- TRACK: constitution security floor ---
# Sessions expire after 60 minutes of inactivity (FR-016). Cookies are HttpOnly, Secure and
# SameSite=Lax; see config/session.php.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Arabic (RTL) is the default interface and English (LTR) the equal second locale, per constitution
# principle VI. The fallback stays English so a missing Arabic key is visible rather than silent.

# Argon2id cost (F-06). OWASP's recommended floor: 19 MiB with 2 iterations beats the Laravel
# default 64 MiB / 4 iterations for a web login, because memory is the parameter an attacker pays
# for and 64 MiB per concurrent sign-in is what the app server pays for. At 30,000 accounts a
# sign-in spike of 50 concurrent requests would reserve 3.2 GiB at the default and under 1 GiB here.
HASH_DRIVER=argon2id
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1
