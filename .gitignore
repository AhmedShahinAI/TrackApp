# --- TRACK: generated paths ---
# Copied from design-system/assets by `npm run build` (T013). The source is committed; the copy is not.
/public/img/brand
# Playwright output. Baselines under tests/Visual/baselines ARE committed — they are the contract.
/test-results
/playwright-report
/blob-report
/playwright/.cache
# Private uploads and import files (constitution security floor: outside the public web root).
/storage/app/private/*
!/storage/app/private/.gitkeep

# --- TRACK: design system delivery archives ---
# The design system is vendored uncompressed under design-system/, which is what the
# visual-regression suite compares against. Committing the zips as well would put ~22 MB of
# duplicate data in history permanently. design-system/VENDORED.md records each archive's name,
# size and date, which is the traceability that matters.
/TRACK Design System*.zip

# Local SQLite databases used for schema verification when no MySQL server is available.
*.sqlite
*.sqlite-journal
