# TRACK — production and staging environment (security plan SEC-072, G-12).
#
# .env.example is the DEVELOPER file: APP_ENV=local, debug on, root database user, debug logging. Copying
# it to a server is the most likely way a production host ends up showing stack traces and serving the
# local-only component gallery. This file is the one to copy for staging and production.
#
# Names and safe defaults only. Every secret is EMPTY here and is provisioned on the server, never
# committed (docs/runbook-deploy.md). AppServiceProvider refuses to boot on production or staging if
# APP_DEBUG is on, SESSION_SECURE_COOKIE is off, or LOG_LEVEL is debug (SEC-073).

APP_NAME="TRACK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://track.example.edu.sa

# The reverse proxy / load balancer in front of PHP, as addresses or CIDRs. Required behind one;
# never `*` (config/trustedproxy.php).
TRUSTED_PROXIES=

SUPPORT_PADDING_MAX_CONCURRENT=40

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

# json lines to daily files; `info`, never `debug`, in production (SEC-073).
LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# A dedicated application user, never root. It must NOT hold UPDATE or DELETE on audit_logs
# (track:audit-grants --strict runs in every deploy, runbook §4).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=track
DB_USERNAME=track_app
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=60
# Session data at rest in Redis is encrypted (G-L1 hardening).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Private network only, with a password (security review 001 R-05).
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# A real relay: with `log`, alert emails are written to a file and nobody is told (G-20).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Where track:monitor sends alerts (config/monitoring.php), and the error tracker (config/sentry.php).
ALERT_EMAIL=
SENTRY_LARAVEL_DSN=

# Uploaded roster files are deleted this many days after their import finished (config/imports.php).
IMPORT_FILE_RETENTION_DAYS=30
# /health shows only its status unless the X-Health-Token header matches this (SEC-091). Give it to the
# load balancer and monitoring only. Empty on a developer machine shows the detail; empty on production
# shows the status only.
HEALTH_TOKEN=

HASH_DRIVER=argon2id
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1

# Backups (config/backup.php, runbook §6, SEC-100). On for staging/production.
BACKUP_ENABLED=true
BACKUP_PATH=/backups/track
BACKUP_KEY_FILE=/etc/track/backup.key
BACKUP_FILES_TARGET=
BACKUP_RETENTION_DAYS=30
